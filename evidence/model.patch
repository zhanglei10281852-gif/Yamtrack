+            side_effect=RuntimeError("write failed"),
+        ), self.assertRaises(RuntimeError):
+            processor._handle_tv_episode(
+                "1668",
+                1,
+                1,
+                PLAYED_PAYLOAD,
+                self.user,
+            )
+
+        self.assertFalse(TV.objects.filter(item__media_id="1668").exists())
